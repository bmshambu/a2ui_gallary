# ── DEV environment config ───────────────────────────────────────────────────
# Copy to .env.dev and fill in. Used when DEPLOYMENT_ENVIRONMENT=dev (default).

GCP_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_CLOUD_STAGING_BUCKET=gs://your-project-adk-staging-dev

# NOTE: distinct name/display_name — deploy matches create-or-update by display_name,
# so a shared name would overwrite the gallery / concierge agents.
AGENT_NAME=a2ui-v09-hello-agent-dev
AGENT_DISPLAY_NAME=A2UI v0.9 Hello Material (Dev)
AGENT_DESCRIPTION=Minimal A2UI v0.9 probe — renders a Material catalog card (colored buttons, elevated card) to confirm GE renders v0.9 and its styling. DEV deployment.
